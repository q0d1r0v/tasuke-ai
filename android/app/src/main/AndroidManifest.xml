<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ══ Permissions ═══════════════════════════════════════════════════════
         This list is the whole privacy story, so it is kept as short as the app
         can possibly function with. Anything added here has to be justifiable in
         store/privacy-policy.html, on the Play Data safety form, and to a user
         reading the app listing. -->
    <!-- Voice capture. The stream goes straight to whisper.cpp in memory; no
         audio is ever written to disk. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"/>
    <!-- flutter_local_notifications 22.x merges this in too; it is declared
         here as well so the app's own manifest states everything it asks for.
         Without it, `requestPermission()` on Android 13+ resolves false with no
         system dialog shown, and every reminder is silently dropped — an app
         that appears to schedule reminders and never fires one. -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Task reminders fire at a user-chosen minute, so they need an exact
         alarm.

         ⚠️ SCHEDULE_EXACT_ALARM, and deliberately NOT USE_EXACT_ALARM.
         USE_EXACT_ALARM is auto-granted and needs no permission screen, which
         makes it the tempting one — but Play restricts it to apps whose *core*
         function is an alarm clock or a calendar, and it audits the declaration
         during review. A productivity app that declares it gets the release
         rejected. SCHEDULE_EXACT_ALARM is user-grantable instead, which is why
         LocalNotifier has a `canScheduleExact()` / `SchedulePrecision.inexact`
         path: a refusal degrades to an inexact alarm (up to an hour late)
         rather than failing. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Alarms do not survive a reboot. Without this the plugin's boot receiver
         is never invoked and every pending reminder is lost when the phone
         restarts. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- ⚠️ Tasuke AI's own code makes no network call at all: there is no
         backend, no analytics, no crash reporter, no ad SDK and no model
         download, and `Failure` has no NetworkFailure arm on purpose. The
         permission reaches the release APK regardless — Play Billing's
         datatransport dependency merges it in (see the service removed
         below) — so it is declared here, where the permission list is read
         and tested, rather than arriving unseen. Using it for anything is a
         product decision and it changes the privacy policy. -->
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <!-- ⚠️ Backup stays ON: the task database has no other copy (there is no
         server). The two rule files keep files/models/ (the 57 MB whisper
         copy) out of it, because Google cloud backup skips an app over 25 MB
         whole rather than trimming it. -->
    <application
        android:label="Tasuke AI"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Portrait only. The recording screen's waveform and the notched
                 bottom nav are both laid out against a fixed aspect; the design
                 has no landscape frame to implement. -->
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- ══ flutter_local_notifications receivers ═════════════════════════
             The plugin's manifest does not declare these; the app's must. They
             are referenced by class name only, which is why proguard-rules.pro
             keeps com.dexterous.** — R8 would otherwise rename the class the
             string here points at, and the receiver would never resolve. -->
        <!-- Delivers a scheduled notification when its alarm fires. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <!-- Re-registers every pending alarm after the device restarts or the
             app is updated. All four actions matter:
               BOOT_COMPLETED       — normal reboot
               MY_PACKAGE_REPLACED  — app update; alarms are dropped on upgrade
               QUICKBOOT_POWERON    — fast-boot ROMs that never send
                                      BOOT_COMPLETED
               com.htc.intent.…     — HTC's own variant of the above -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action
                    android:name="android.intent.action.BOOT_COMPLETED"/>
                <action
                    android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action
                    android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action
                    android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Handles a notification action button tapped while the app is not in
             the foreground. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>
        <!-- ⚠️ Removes Google's telemetry uploader, which Play Billing brings in.

             in_app_purchase_android depends on com.android.billingclient:billing,
             and billing depends on com.google.android.datatransport. Its
             TransportBackendDiscovery service is how datatransport finds the
             backend that uploads billing-client logs to
             firebaselogging.googleapis.com. It ran from the first app start,
             because the store subscription opens a BillingClient at bootstrap.
             That broke the promise the INTERNET comment above makes: nothing
             the app runs talks to the network.

             With the service gone, datatransport finds no backend and drops
             its events locally ("Unknown backend"). Purchases are unaffected:
             they go through the Play Store app over IPC, not through this.

             ⚠️ Do NOT also remove ACCESS_NETWORK_STATE, which datatransport
             merges in. Its uploader still checks connectivity before it finds
             out there is no backend, and without the permission that check
             throws a SecurityException. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
    <!-- ══ Package visibility ════════════════════════════════════════════════
         API 30+ hides other installed apps from us unless we declare what we
         intend to look for. -->
    <queries>
        <!-- ⚠️ Without this block, url_launcher's `canLaunchUrl` returns false
             on API 30+ for an https URL on a phone that obviously has a
             browser — the resolver simply cannot see Chrome. The symptom is that
             the Privacy Policy and Terms rows in Settings do nothing at all: no
             error, no crash, no log. Every in-app link this app opens is https
             (the policy pages and the store subscription-management deep
             links). -->
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <data
                android:scheme="https"/>
        </intent>
        <!-- Required to query activities that can process text, see:
             https://developer.android.com/training/package-visibility and
             https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

             In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>