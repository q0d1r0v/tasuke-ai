<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- ══ Privacy usage descriptions ═══════════════════════════════════════
	     iOS shows the string verbatim in the permission sheet, so it has to
	     answer "why" in one sentence.

	     ⚠️ A missing usage-description string is not a denial — it is an
	     immediate, uncatchable crash the first time the API is touched
	     (`NSInvalidArgumentException`, "app must contain an
	     NSMicrophoneUsageDescription key"). Nothing on Linux reproduces it and
	     no Dart test can: `record` fails on the simulator too, so this only
	     shows up on a device, at the exact moment a reviewer taps the mic. -->
		<key>NSMicrophoneUsageDescription</key>
		<string>Tasuke AI needs your microphone to hear the tasks you speak. Your voice is processed entirely on this device and is never recorded to a file or uploaded.</string>
		<!-- ══ Keys deliberately ABSENT ═════════════════════════════════════════
	     Each of these is something a reviewer, a linter or a well-meaning
	     contributor will eventually try to add. Do not.

	     • NSSpeechRecognitionUsageDescription — Apple's Speech framework is NOT
	       used. Transcription is whisper.cpp, on device, offline. Declaring the
	       key would advertise a capability the binary does not contain and
	       invites the "your app requests speech recognition but we could not
	       find the feature" rejection.
	     • NSPhotoLibraryUsageDescription / NSPhotoLibraryAddUsageDescription,
	       NSLocationWhenInUseUsageDescription / NSLocationAlwaysAndWhenInUse…,
	       NSCalendarsUsageDescription / NSRemindersUsageDescription,
	       NSContactsUsageDescription — none of these APIs is reached. The
	       permission_handler post_install hook in ios/Podfile compiles them out
	       of the pod, which is what makes their absence here safe rather than a
	       latent crash, and what keeps PrivacyInfo.xcprivacy's
	       NSPrivacyCollectedDataTypes honestly empty.
	     • NSUserTrackingUsageDescription — there is no IDFA, no ad SDK, no
	       analytics and no attribution. Adding the key would make App Store
	       Connect ask us to declare tracking we do not do.
	     • UIBackgroundModes — ⚠️ the most tempting one, and the one that gets
	       an app rejected. Recording is modal and strictly foreground: the
	       capture sheet owns the screen and ends when the user stops talking.
	       Reminders are LOCAL notifications, which the OS delivers on our
	       behalf with the app suspended or terminated, so no `audio`,
	       `processing` or `fetch` mode buys anything. An unused background mode
	       is guideline 2.5.4 — "an app that declares background audio but does
	       not play audible content". -->
		<!-- ══ Export compliance ════════════════════════════════════════════════
	     `false` because the app implements no cryptography and makes no network
	     request of its own; the store's billing is Apple's. Setting this here
	     answers the export-compliance questionnaire at build time; omitting it
	     makes every single upload stop and wait for a human to answer the same
	     two questions again. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<!-- The name under the icon on the Home Screen. -->
		<key>CFBundleDisplayName</key>
		<string>Tasuke AI</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Tasuke AI</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- ══ Deep links ═══════════════════════════════════════════════════════
	     `tasuke://` is used for nothing but returning to a specific screen —
	     there is no universal link, because that would need an
	     apple-app-site-association file on a server, and this app has no
	     server. FlutterDeepLinkingEnabled hands the URL to go_router instead of
	     requiring native handling in AppDelegate. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>uz.digitalgroup.tasuke</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>tasuke</string>
				</array>
			</dict>
		</array>
		<key>FlutterDeepLinkingEnabled</key>
		<true/>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- ══ Orientation ══════════════════════════════════════════════════════
	     Portrait only. The recording sheet's waveform and the notched bottom
	     nav are laid out against a fixed aspect ratio and the design sheet has
	     no landscape frame.

	     ⚠️ That is why the app is iPhone-only (TARGETED_DEVICE_FAMILY = 1 in
	     project.pbxproj). A portrait-only iPad app is rejected at upload with
	     ITMS-90474 (iPad multitasking needs all four orientations), and
	     UIRequiresFullScreen, the old opt-out, is deprecated. On an iPad the
	     app runs in iPhone compatibility mode. The ~ipad list is kept identical
	     so nothing rotates on an iPad either way. -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<!-- Lets the engine drive a 120 Hz display instead of being capped at 60.
	     The waveform and the mic-button pulse are the two animations where the
	     difference is visible. -->
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
