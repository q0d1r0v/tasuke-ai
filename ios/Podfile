# ⚠️ 16.4, and it must stay in lockstep with IPHONEOS_DEPLOYMENT_TARGET in
# ios/Runner.xcodeproj/project.pbxproj (all three configurations).
#
# 16.4 is the floor the app ships with, and nothing requires lowering it. The
# reason the two files both carry the number is that nothing reconciles them:
# CocoaPods reads THIS file to resolve pods and to stamp the Pods project, and
# Xcode reads the pbxproj for the app target. When they disagree the failure is not a clean
# "deployment target too low": you get a linker error about a symbol built for a
# newer iOS, or a pod that silently compiles its unavailable branch.
# test/app/platform/ios_plist_test.dart asserts both files say 16.4.
platform :ios, '16.4'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # ── Deployment-target sweep ───────────────────────────────────────────
      #
      # `platform :ios` above sets the floor for dependency RESOLUTION, but a
      # pod that declares its own lower target keeps it, and Xcode 16 emits an
      # error (not a warning) for a pod built below the workspace minimum. One
      # transitive dependency still shipping an 11.0 podspec is enough to fail
      # the whole archive, so every pod target is normalised here.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'

      # ── permission_handler compile-time trimming ──────────────────────────
      #
      # ⚠️ This is a privacy requirement, not an optimisation.
      #
      # permission_handler_apple compiles EVERY permission handler by default —
      # photos, location, contacts, calendar, motion, Bluetooth. Each one
      # references the matching framework API, and Apple's static scanner sees
      # those references in the binary. The result is an App Review rejection
      # asking why a voice-to-task app links PHPhotoLibrary, and a privacy
      # manifest that cannot honestly stay empty.
      #
      # Declaring exactly the two macros below strips the rest of the handlers
      # out of the compilation entirely, so the shipped binary contains no
      # reference to any API this app does not use. It is also what lets
      # ios/Runner/Info.plist omit NSPhotoLibrary*, NSLocation*, NSContacts*
      # and NSCalendars* without the app crashing the moment some unused
      # handler is touched.
      if target.name == 'permission_handler_apple'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
          '$(inherited)',
          'PERMISSION_MICROPHONE=1',
          'PERMISSION_NOTIFICATIONS=1',
        ]
      end
    end
  end
end
