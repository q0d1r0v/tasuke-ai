  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"title_folded\" TEXT NOT NULL, \"notes\" TEXT NULL, \"due_date\" TEXT NULL, \"due_minute_of_day\" INTEGER NULL, \"reminder_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reminder_enabled\" IN (0, 1)), \"reminder_lead_minutes\" INTEGER NOT NULL DEFAULT 0, \"reminder_at_local\" TEXT NULL, \"notification_id\" INTEGER NULL, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"completed_at_utc_ms\" INTEGER NULL, \"created_at_utc_ms\" INTEGER NOT NULL, \"updated_at_utc_ms\" INTEGER NOT NULL, \"source\" TEXT NOT NULL, \"source_transcript\" TEXT NULL, \"capture_id\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at_utc_ms\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "usage_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"usage_days\" (\"day\" TEXT NOT NULL, \"capture_count\" INTEGER NOT NULL DEFAULT 0, \"task_count\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"day\"));"
        }
      ]
    },
