# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Husky is the only JavaScript in this repo and it is a dev dependency.
/node_modules/

# ⚠️ Signing material. `android/key.properties` names the keystore and carries
# its passwords, and the .jks IS the identity of the app on Play — losing it
# means you can never ship an update again, and committing it means anybody with
# repo access can. Back the keystore up somewhere that is not this repository.
**/key.properties
*.jks
*.keystore
*.p12
*.mobileprovision

# Store screenshots are regenerated from the emulator.
/store/screenshots/

# ⚠️ Generated per build, and STALE between build types. After
# `flutter drive`/`flutter test integration_test` it still registers
# `integration_test`, which is a dev dependency — and the next
# `flutter build apk --release` then fails with
# "package dev.flutter.plugins.integration_test does not exist".
# Deleting the directory (or `flutter clean`) regenerates it correctly.
/android/app/src/main/java/io/flutter/plugins/

# Native build output inside vendored packages. The package carries its own
# .gitignore too; this is the belt to that's braces, because a stray
# `packages/whisper_ggml/android/.cxx` is 161 MB of machine-specific CMake
# cache that reappears as "modified" after every build.
packages/*/android/.cxx/
packages/*/android/build/
packages/*/android/.gradle/

# Golden comparison output. Written next to the goldens on a failure and never
# useful in a commit — the four PNGs are the master, the candidate and two
# diffs of a run that is already red on the developer's screen.
test/**/failures/
